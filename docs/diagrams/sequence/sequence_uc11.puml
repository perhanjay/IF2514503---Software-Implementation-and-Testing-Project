@startuml
skinparam monochrome true
skinparam shadowing false
skinparam roundCorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam titleBorderColor #000000
skinparam titleBorderThickness 1.5
skinparam titleBackgroundColor #FFFFFF
skinparam titleFontSize 14
skinparam titleFontStyle bold

skinparam sequence {
    ArrowColor #000000
    ArrowThickness 1.2
    ActorBorderColor #000000
    ActorBackgroundColor #FFFFFF
    LifeLineBorderColor #000000
    LifeLineBackgroundColor #FFFFFF
    ParticipantBorderColor #000000
    ParticipantBackgroundColor #FFFFFF
    BoxBorderColor #000000
    BoxBackgroundColor #FFFFFF
    GroupBorderColor #000000
    GroupHeaderFontColor #000000
    GroupBackgroundColor #FFFFFF
    DividerBorderColor #000000
    DividerBackgroundColor #FFFFFF
    DividerFontColor #000000
    DividerFontSize 12
    DividerFontStyle bold
}

title Sequence Diagram: Memverifikasi Integritas & Sinkronisasi Sesi (UC-11)

actor "Audio Engineer" as User

box "Presentation Layer (Frontend)"
boundary "Halaman Verifikasi Sesi\n(Web UI)" as UI
end box

box "Application & Business Logic Layer (Backend API)"
control "VerificationController\n(API Gateway)" as VerifyCtrl
control "AuthMiddleware\n(JWT Guard)" as AuthGuard
entity "SessionVerificationService\n(Integrity Core)" as VerifySvc
control "DspAnalysisWorker\n(Sync & Silence Engine)" as DspWorker
end box

box "External Storage / Infrastructure"
control "Cloud Object Storage\n(S3 / MinIO Storage)" as Storage
end box

box "Persistence Layer"
database "Database\n(PostgreSQL)" as DB
end box

autonumber 1 "[00]"

== Fase 1: Inisiasi Verifikasi Otomatis & Pemindaian Integritas Audio ==

User -> UI : Buka modul verifikasi sesi (/sessions/{id}/verify)
activate User
activate UI

UI -> VerifyCtrl : POST /api/v1/sessions/{id}/verify-integrity (Bearer JWT)
activate VerifyCtrl

VerifyCtrl -> AuthGuard : validateSession(token)
activate AuthGuard
AuthGuard --> VerifyCtrl : SessionValid (user_id)
deactivate AuthGuard

VerifyCtrl -> VerifySvc : startSessionVerification(session_id)
activate VerifySvc

VerifySvc -> DB : SELECT id, name, duration, sample_rate, bit_depth FROM session_tracks WHERE session_id = ?
activate DB
DB --> VerifySvc : Metadata daftar trek sesi
deactivate DB

VerifySvc -> DspWorker : dispatch(VerifySyncAndAudioContentJob)
activate DspWorker

DspWorker -> Storage : streamTrackAudioSamples(session_id)
activate Storage
Storage --> DspWorker : Stream data cuplikan sinyal audio
deactivate Storage

DspWorker -> DspWorker : Periksa keselarasan titik awal (zero-aligned) & durasi
DspWorker -> DspWorker : Pindai RMS & amplitudo puncak (deteksi keheningan digital 100%)
DspWorker -> DspWorker : Periksa konsistensi sample rate antar-trek (44.1 kHz vs 48 kHz)

DspWorker -> DB : UPDATE session_tracks SET is_zero_aligned = ?, is_silent = ?, resample_needed = ? WHERE id = ?
activate DB
DB --> DspWorker : TrackFlagsUpdated
deactivate DB

DspWorker --> VerifySvc : VerificationResults (sync_ok, sample_rate_status, silent_tracks, offset_tracks)
deactivate DspWorker

VerifySvc --> VerifyCtrl : VerificationSummaryData
deactivate VerifySvc

VerifyCtrl --> UI : 200 OK (verification_summary, track_statuses)
deactivate VerifyCtrl

UI --> User : Render tabel status verifikasi (Ikon centang / peringatan oranye)
deactivate UI

== Fase 2: Penanganan Kondisi Khusus & Opsi Resolusi Anomali ==

alt Perbedaan Sample Rate Campuran (Mixed Sample Rate Detected)
  User -> UI : Setujui opsi penyesuaian sample rate otomatis (48 kHz)
  activate UI

  UI -> VerifyCtrl : POST /api/v1/sessions/{id}/resample (target_sr: 48000)
  activate VerifyCtrl

  VerifyCtrl -> VerifySvc : triggerBatchResampling(session_id, 48000)
  activate VerifySvc

  VerifySvc -> DspWorker : dispatch(BatchResamplingJob)
  activate DspWorker

  DspWorker -> Storage : Baca audio 44.1 kHz, jalankan bandlimited resampling, & simpan hasil 48 kHz
  activate Storage
  Storage --> DspWorker : AudioResampledWritten
  deactivate Storage

  DspWorker -> DB : UPDATE session_tracks SET sample_rate = 48000 WHERE session_id = ?
  activate DB
  DB --> DspWorker : TracksUpdated
  deactivate DB

  DspWorker --> VerifySvc : ResamplingCompleted
  deactivate DspWorker

  VerifySvc --> VerifyCtrl : ResampleSuccess
  deactivate VerifySvc

  VerifyCtrl --> UI : 200 OK ("Sample rate seluruh trek diselaraskan ke 48 kHz")
  deactivate VerifyCtrl

  UI --> User : Perbarui badge indikator menjadi centang hijau ("48 kHz Seragam")
  deactivate UI

else Terdeteksi Anomali Trek Hening / Offset Durasi
  User -> UI : Tekan tombol "Hapus Trek Kosong" untuk menghemat token
  activate UI

  UI -> VerifyCtrl : DELETE /api/v1/sessions/{id}/tracks/{track_id}
  activate VerifyCtrl

  VerifyCtrl -> VerifySvc : removeTrack(session_id, track_id)
  activate VerifySvc

  VerifySvc -> DB : DELETE FROM session_tracks WHERE id = ?
  activate DB
  DB --> VerifySvc : TrackDeleted
  
  VerifySvc -> DB : UPDATE sessions SET track_count = track_count - 1 WHERE id = ?
  DB --> VerifySvc : SessionTrackCountUpdated
  deactivate DB

  VerifySvc --> VerifyCtrl : TrackRemovalResult (new_track_count, new_token_cost)
  deactivate VerifySvc

  VerifyCtrl --> UI : 200 OK (new_track_count, new_token_cost)
  deactivate VerifyCtrl

  UI --> User : Hapus baris trek dari tabel & sesuaikan kalkulasi kebutuhan token
  deactivate UI

else Semua Trek Sinkron & Terverifikasi Utuh
  UI --> User : Tampilkan badge hijau ("Semua Trek Sinkron & Siap Diproses")
end

== Fase 3: Konfirmasi Final & Kunci Sesi untuk Klasifikasi AI ==

User -> UI : Tinjau ringkasan akhir dan tekan tombol "Lanjut ke Klasifikasi"
activate UI

UI -> VerifyCtrl : POST /api/v1/sessions/{id}/finalize-verification (Bearer JWT)
activate VerifyCtrl

VerifyCtrl -> VerifySvc : finalizeVerification(session_id)
activate VerifySvc

VerifySvc -> DB : UPDATE sessions SET status = 'VERIFIED_READY_FOR_AI', verified_at = NOW() WHERE id = ?
activate DB
DB --> VerifySvc : SessionLocked
deactivate DB

VerifySvc --> VerifyCtrl : FinalizeSuccess
deactivate VerifySvc

VerifyCtrl --> UI : 200 OK (redirect_url: /sessions/{id}/classify)
deactivate VerifyCtrl

UI --> User : Arahkan pengguna ke tahap Mengoreksi Label & Pasangan Track Secara Manual (UC-12)
deactivate UI

deactivate User

@enduml
